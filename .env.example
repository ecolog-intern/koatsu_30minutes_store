# AWS設定
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
region=ap-northeast-1
bucket_name=your_bucket_name

# クライアント証明書（Base64エンコード）
# 以下のコマンドで生成できます:
# base64 -i certificate/client.crt | tr -d '\n'
# base64 -i certificate/client.key | tr -d '\n'
CLIENT_CERT_BASE64=
CLIENT_KEY_BASE64=
